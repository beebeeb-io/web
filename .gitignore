# Dependencies & vendor
node_modules/
vendor/
.pnpm-store/
bun.lockb

# Build artifacts
target/
dist/
build/
.next/
.astro/
*.wasm
# But do track the vendored beebeeb-wasm package (workspace dep for CI standalone clones)
!packages/beebeeb-wasm/*.wasm

# Environment & secrets
.env
.env.local
.env.*.local
!.env.development
!.env.production
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.secret
id_rsa
id_ed25519
credentials.json
service_account.json
token.json

# Local data
data/
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
*.swp
*.swo
*~
.vscode/settings.json
.vscode/launch.json

# Logs
*.log
npm-debug.log*
# preview-matrix fixture — a real .log sample the matrix uploads, not a
# generated log file (task 1565 / PR #107 review)
!e2e/fixtures/preview-matrix/text/sample.log

# Test & coverage
coverage/
.nyc_output/
*.lcov

# Expo / React Native
.expo/
ios/Pods/
android/.gradle/
android/app/build/

# Playwright MCP captures (logs, snapshots) — ignored repo-wide
.playwright-mcp/
test-results/
playwright-report/
qa-screenshots/
playwright/.auth/

# scripts/prod-smoke.sh's per-run scratch (CLI binary, isolated HOME, blobs,
# logs) — trap-cleaned on every exit; ignored defensively in case a run is
# ever killed -9 before its trap can run (task 1495).
.prod-smoke-scratch/

# Graphify per-file AST cache — local incremental data, not for the repo.
# graph.json / graph.html / GRAPH_REPORT.md (the rest of graphify-out/) are
# intentionally tracked.
graphify-out/cache/
graphify-out/.graphify_root
app.json
.claude/worktrees/
/e2e/screenshots/

# Office editor engine bundle (task 1567) — the LibreOffice-WASM binaries
# (soffice.wasm/.data, tens to hundreds of MB) never belong in git, same
# convention as repos/office's own .gitignore. scripts/office-dev-assets.sh
# assembles this directory from a local repos/office build for dev/e2e use.
/public/office/

# Office bundle PRODUCTION staging (task 1567 hosting) — the Brotli-
# precompressed, versioned bundle scripts/office-bundle-stage.sh assembles
# for the Docker image (see Dockerfile). Same "binaries never belong in git"
# rule as /public/office/ above; the .gitkeep keeps the directory itself
# tracked so the Dockerfile's COPY of it never fails a build where nobody
# ran the staging script first.
/office-bundle-staging/*
!/office-bundle-staging/.gitkeep

