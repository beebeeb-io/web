  "docsDir": "../../../.design-sync/docs",
  "overrides": {
    "BBLogo": {
      "cardMode": "column"
    },
    "Icon": {
      "cardMode": "column"
    },
    "CardSkeleton": {
      "cardMode": "column"
    },
    "FileRowSkeleton": {
      "cardMode": "column"
    },
    "PhotoGroupSkeleton": {
      "cardMode": "column"
    },
    "SharedRowSkeleton": {
      "cardMode": "column"
    },
    "TrashRowSkeleton": {
      "cardMode": "column"
    }
  }
}
