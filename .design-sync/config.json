{
  "pkg": "@beebeeb/shared",
  "globalName": "Beebeeb",
  "projectId": "7a59104f-d27e-4f90-8e3d-a73f8be06b67",
  "shape": "package",
  "buildCmd": "bunx @tailwindcss/cli@4.3.0 -i .design-sync/tailwind-entry.css -o packages/shared/.ds-css/beebeeb.css --minify",
  "cssEntry": ".ds-css/beebeeb.css",
  "extraFonts": [
    "../../@fontsource/inter/400.css",
    "../../@fontsource/inter/500.css",
    "../../@fontsource/inter/600.css",
    "../../@fontsource/inter/700.css",
    "../../@fontsource/jetbrains-mono/400.css",
    "../../@fontsource/jetbrains-mono/500.css"
  ],
  "readmeHeader": ".design-sync/conventions.md",
  "componentSrcMap": {
    "ApiError": null,
    "IncorrectPasswordError": null,
    "SessionTooOldForConfirmationError": null
