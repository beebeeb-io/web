# Vite — API base URL (default http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Opt-in error reporting DSN (@beebeeb/shared telemetry reporter → our own
# GlitchTip in Falkenstein). Leave UNSET: errors.beebeeb.io has no DNS record
# yet, and an unset/empty DSN makes the reporter a guaranteed no-op. See
# deploy/glitchtip/README.md (workspace root) for the project DSNs once live.
# VITE_ERROR_REPORTING_DSN=

# Playwright e2e — test-account credentials.
# Used by e2e/helpers/auth.ts to drive the real OPAQUE login flow including
# the DeviceProvision recovery-phrase step. Copy to a local `.env` (gitignored)
# and fill in values from /beebeeb:test-accounts. NEVER commit real values.
BB_TEST_USER_EMAIL=
BB_TEST_USER_PASSWORD=
BB_TEST_USER_RECOVERY_PHRASE=
